# Copier en .env et compléter. Ne jamais committer de vraies valeurs.

# Rôle applicatif hk_app (soumis à la Row-Level Security, sans BYPASSRLS)
DATABASE_URL="postgresql://hk_app:hk_app_dev@localhost:5432/harvest_kids"
# Rôle propriétaire, utilisé uniquement par prisma migrate
DATABASE_MIGRATION_URL="postgresql://hk_owner:hk_owner_dev@localhost:5432/harvest_kids"

# Neon (environnement de test), format des chaînes (voir docs/exploitation.md) :
#   DATABASE_URL           postgresql://hk_app:…@ep-…-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
#   DATABASE_MIGRATION_URL postgresql://neondb_owner:…@ep-….eu-central-1.aws.neon.tech/neondb?sslmode=require
# verify-full pour DATABASE_URL (pilote pg) ; require pour DATABASE_MIGRATION_URL, car le
# moteur de prisma migrate ne connaît pas verify-full et retomberait sur prefer.

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# local (volume Docker / dossier local) ou vercel-blob (environnement de test)
STORAGE_DRIVER="local"
# Avec vercel-blob : jeton du Blob store, à ajouter à la main (le store ne l'injecte pas)
BLOB_READ_WRITE_TOKEN=""
UPLOADS_DIR="./uploads"

DEFAULT_TIMEZONE="Africa/Porto-Novo"

# Création du premier super-administrateur par le seed
SUPER_ADMIN_EMAIL=""

# Optionnel
SENTRY_DSN=""

# Tests d'intégration (base dédiée, vidée par les tests)
TEST_DATABASE_URL="postgresql://hk_app:hk_app_dev@localhost:5432/harvest_kids_test"
TEST_DATABASE_MIGRATION_URL="postgresql://hk_owner:hk_owner_dev@localhost:5432/harvest_kids_test"
