// Harvest Kids — schéma de données (lots 0 et 1)
//
// Deux familles de tables :
// - PLATEFORME (hors RLS) : Eglise, User, Membre, AccesSupport, AuditPlateforme et
//   les tables Better Auth. Accès uniquement depuis src/server/plateforme/, src/lib/tenant.ts
//   et src/lib/auth.ts.
// - ÉGLISE (tenant, sous RLS) : toutes les autres. Chacune porte `egliseId`, une politique
//   Row-Level Security (migration SQL) et `@@unique([id, egliseId])` pour que les relations
//   entre tables tenant soient composites : un lien vers une ligne d'une autre église est
//   impossible en base (ADR 0002).
//
// Les relations optionnelles composites portent `onDelete: Restrict` : l'action par défaut
// (SetNull) tenterait de vider aussi `egliseId`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RESPONSABLE
  ACCUEIL
  MONITEUR
  INFIRMERIE
  ECRAN
}

enum StatutPresence {
  PRESENT
  EN_SALLE
  INFIRMERIE
  RECUPERE
}

enum StatutSession {
  PLANIFIEE
  OUVERTE
  CLOTUREE
}

enum StatutEglise {
  ACTIVE
  SUSPENDUE
}

enum TypeIncident {
  BLESSURE
  MALAISE
  COMPORTEMENT
  ENFANT_INTROUVABLE
  RETRAIT_NON_AUTORISE
  AUTRE
}

// RG-16 : une carte par famille (par défaut) ou une carte par enfant.
enum ModeCarte {
  FAMILLE
  ENFANT
}

// =====================================================================
// PLATEFORME (hors RLS)
// =====================================================================

model Eglise {
  id                String       @id @default(cuid())
  nom               String
  slug              String       @unique // /ecran/[slug]
  logoKey           String? // logo principal (fonds clairs)
  logoClairKey      String? // variante claire (fonds sombres)
  telephoneAccueil  String? // imprimé sur les cartes famille
  adresse           String?
  fuseau            String       @default("Africa/Porto-Novo") // RG-12
  statut            StatutEglise @default(ACTIVE)
  prochainMatricule Int          @default(1) // RG-01, incrémenté de façon atomique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  membres               Membre[]
  ecrans                EcranAppareil[]
  accesSupport          AccesSupport[]
  familles              Famille[]
  tuteurs               Tuteur[]
  personnesAutorisees   PersonneAutorisee[]
  enfants               Enfant[]
  cartes                CarteFamille[]
  reemissions           ReemissionCartes[]
  badges                BadgeMoniteur[]
  classes               Classe[]
  cultes                Culte[]
  sessions              Session[]
  sessionClasses        SessionClasse[]
  affectations          AffectationMoniteur[]
  presences             Presence[]
  evenements            EvenementPresence[]
  appels                Appel[]
  appelsTelephoniques   AppelTelephonique[]
  incidents             Incident[]
  incidentNotes         IncidentNote[]
  auditLogs             AuditLog[]
  parametres            Parametre[]
  retraitsExceptionnels RetraitExceptionnel[]
  fichiersASupprimer    FichierASupprimer[]
}

// Compte (Better Auth). `name` et `email` sont imposés par Better Auth ; un compte créé par
// téléphone seul reçoit un e-mail technique non routable (<id>@telephone.invalid).
model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  telephone        String?  @unique
  telephoneVerifie Boolean  @default(false)
  superAdmin       Boolean  @default(false) // seul rôle global
  actif            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  membres           Membre[]
  sessions          AuthSession[]
  comptes           AuthAccount[]
  jetonsCompte      JetonCompte[]
  accesSupport      AccesSupport[]
  forcagesClasses   SessionClasse[]       @relation("ForcageClasse")
  retraitsAutorises RetraitExceptionnel[] @relation("RetraitAutorisePar")
  retraitsRemis     RetraitExceptionnel[] @relation("RetraitRemisPar")
}

// Rattachement d'un compte à une église. Hors RLS : il faut pouvoir lister les églises
// d'un utilisateur avant qu'il en choisisse une.
model Membre {
  id              String    @id @default(cuid())
  egliseId        String
  eglise          Eglise    @relation(fields: [egliseId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NOT NULL DEFAULT '{}' (migration tableaux_non_nuls) : une liste vide, jamais NULL.
  roles           Role[]    @default([])
  pinHash         String?
  pinEchecs       Int       @default(0)
  pinBloqueJusqua DateTime?
  actif           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  affectations AffectationMoniteur[]
  badges       BadgeMoniteur[]

  @@unique([egliseId, userId])
  @@unique([id, egliseId])
  @@index([userId])
}

// Accès de support d'un super-administrateur à une église, limité dans le temps
// (développé dans un lot ultérieur).
model AccesSupport {
  id       String   @id @default(cuid())
  egliseId String
  eglise   Eglise   @relation(fields: [egliseId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  motif    String
  debut    DateTime @default(now())
  fin      DateTime

  @@index([egliseId, fin])
}

// Journal des actions de plateforme (création, suspension d'une église…). Non modifiable.
model AuditPlateforme {
  id        String   @id @default(cuid())
  userId    String?
  egliseId  String? // église concernée, le cas échéant (pas de relation : survit à la suppression)
  action    String
  detail    Json?
  appareil  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum TypeJetonCompte {
  ACTIVATION
  REINITIALISATION
}

// Lien d'activation d'un compte ou de réinitialisation de son mot de passe (cahier §7.10,
// ADR 0014). Hors RLS : la page d'activation est publique et ne connaît pas l'église. Seule
// l'empreinte SHA-256 du jeton est stockée. L'échéance est posée en SQL selon le type
// (now() + 7 jours ou 24 heures) et comparée à now() de PostgreSQL.
model JetonCompte {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  egliseId   String // église de l'administrateur qui l'a émis (pas de relation : audit)
  type       TypeJetonCompte
  tokenHash  String          @unique
  expireLe   DateTime
  consommeLe DateTime?
  revoqueLe  DateTime? // remplacé par un nouveau lien
  creePar    String // userId de l'administrateur (ou du super-administrateur)
  createdAt  DateTime        @default(now())

  @@index([userId, type])
}

// Écran d'appel appairé (cahier §7.8, ADR 0018). Hors RLS : l'écran n'a pas de session, il est
// reconnu par son cookie avant qu'on connaisse l'église. L'ADMIN crée un écran nommé et reçoit
// un lien d'appairage à usage unique (valable 24 h, échéance posée en SQL), échangé une seule
// fois contre le secret de l'appareil, gardé dans un cookie longue durée. Seules les empreintes
// SHA-256 sont stockées. Révocable écran par écran ; jamais effacé (historique).
model EcranAppareil {
  id            String    @id @default(cuid())
  egliseId      String
  eglise        Eglise    @relation(fields: [egliseId], references: [id], onDelete: Cascade)
  nom           String // « Salle principale »
  jetonHash     String    @unique // lien d'appairage
  jetonExpireLe DateTime // now() + 24 heures
  appaireLe     DateTime? // lien consommé ; non nul si et seulement si appareilHash l'est
  appareilHash  String?   @unique // secret du cookie de l'appareil
  derniereVue   DateTime? // mise à jour au plus une fois par minute
  creePar       String // userId de l'administrateur
  creeLe        DateTime  @default(now())
  revoqueLe     DateTime?
  revoquePar    String?

  @@index([egliseId])
}

// ---------- Tables Better Auth

model AuthSession {
  id               String    @id @default(cuid())
  token            String    @unique
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  egliseActiveId   String? // église active, vérifiée à chaque accès par getTenantDb()
  derniereActivite DateTime? // verrouillage PIN après 15 min d'inactivité
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Compteurs de limitation des tentatives (partagés entre instances, donc en base).
model AuthRateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// =====================================================================
// ÉGLISE (tenant, sous RLS)
// =====================================================================

model Famille {
  id                  String    @id @default(cuid())
  egliseId            String
  eglise              Eglise    @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  nom                 String
  notes               String?
  consentementDonnees DateTime?
  consentementPhotos  DateTime?
  // null = brouillon (import CSV) : ni matricule, ni carte, ni check-in, purgé après le délai
  // de l'église. Renseigné à la finalisation (consentement + personne autorisée avec photo).
  finaliseeLe         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tuteurs               Tuteur[]
  enfants               Enfant[]
  autorises             PersonneAutorisee[]
  cartes                CarteFamille[]
  retraitsExceptionnels RetraitExceptionnel[]

  @@unique([id, egliseId])
  @@index([egliseId, nom])
}

model Tuteur {
  id         String  @id @default(cuid())
  egliseId   String
  eglise     Eglise  @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  familleId  String
  famille    Famille @relation(fields: [familleId, egliseId], references: [id, egliseId], onDelete: Cascade)
  prenom     String
  nom        String
  lien       String
  /// Always set for the main contact of a saved family (enregistrerFamille); may be null
  /// for another guardian, or in a draft (CSV import: missing, unreadable, not confirmed).
  telephone  String?
  telephone2 String?
  whatsapp   String?
  principal  Boolean @default(false)

  autorise PersonneAutorisee?

  @@unique([id, egliseId])
  @@index([egliseId, telephone])
  @@index([familleId])
}

model PersonneAutorisee {
  id        String  @id @default(cuid())
  egliseId  String
  eglise    Eglise  @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  familleId String
  famille   Famille @relation(fields: [familleId, egliseId], references: [id, egliseId], onDelete: Cascade)
  tuteurId  String?
  tuteur    Tuteur? @relation(fields: [tuteurId, egliseId], references: [id, egliseId], onDelete: Restrict)
  prenom    String
  nom       String
  lien      String
  telephone String?
  photoKey  String // obligatoire (RG-06)
  actif     Boolean @default(true)

  retraits Presence[]

  @@unique([tuteurId, egliseId])
  @@unique([id, egliseId])
  @@index([familleId])
  // Recherche par téléphone limitée à l'église active (ADR 0011).
  @@index([egliseId, telephone])
}

model Enfant {
  id             String   @id @default(cuid())
  egliseId       String
  eglise         Eglise   @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  matricule      String? // HK-0001, unique dans l'église (RG-01) ; null tant que la famille est en brouillon
  familleId      String
  famille        Famille  @relation(fields: [familleId, egliseId], references: [id, egliseId], onDelete: Restrict)
  prenom         String
  nom            String
  dateNaissance  DateTime @db.Date
  sexe           String?
  photoKey       String?
  // NOT NULL DEFAULT '{}' (migration tableaux_non_nuls) : une liste vide, jamais NULL.
  alertes        String[] @default([])
  alerteDetail   String?
  notes          String?
  classeForceeId String?
  classeForcee   Classe?  @relation(fields: [classeForceeId, egliseId], references: [id, egliseId], onDelete: Restrict)
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  presences           Presence[]
  incidents           Incident[]
  appelsTelephoniques AppelTelephonique[]
  cartes              CarteFamille[]

  @@unique([egliseId, matricule])
  @@unique([id, egliseId])
  // Cible de la clé composite des cartes enfant : l'enfant appartient à la famille de la carte.
  @@unique([id, familleId, egliseId])
  @@index([familleId])
  @@index([egliseId, nom, prenom])
}

// Carte famille (enfantId null) ou carte enfant (RG-16). Cycle de vie (ADR 0008) :
// en attente (activeLe null) → active (activeLe renseigné) → révoquée (revoqueeLe renseigné).
// Une carte réimprimée reste en attente jusqu'à sa remise ou sa première utilisation ;
// l'ancienne reste valide jusque-là. Au plus une carte active et une carte en attente par
// couverture (famille ou enfant), garanties par les index partiels ci-dessous.
model CarteFamille {
  id           String            @id @default(cuid())
  egliseId     String
  eglise       Eglise            @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  familleId    String
  famille      Famille           @relation(fields: [familleId, egliseId], references: [id, egliseId], onDelete: Cascade)
  enfantId     String?
  enfant       Enfant?           @relation(fields: [enfantId, familleId, egliseId], references: [id, familleId, egliseId], onDelete: Restrict)
  tokenHash    String            @unique // SHA-256 hexadécimal du jeton HKF1. (RG-02) ; le jeton en clair n'est jamais stocké
  emiseLe      DateTime          @default(now())
  activeLe     DateTime? // null = en attente
  revoqueeLe   DateTime? // RG-03
  reemissionId String?
  reemission   ReemissionCartes? @relation(fields: [reemissionId, egliseId], references: [id, egliseId], onDelete: Restrict)

  @@unique([id, egliseId])
  @@unique([familleId], where: raw("\"revoqueeLe\" IS NULL AND \"activeLe\" IS NOT NULL AND \"enfantId\" IS NULL"), map: "CarteFamille_famille_active")
  @@unique([enfantId], where: raw("\"revoqueeLe\" IS NULL AND \"activeLe\" IS NOT NULL AND \"enfantId\" IS NOT NULL"), map: "CarteFamille_enfant_active")
  @@unique([familleId], where: raw("\"revoqueeLe\" IS NULL AND \"activeLe\" IS NULL AND \"enfantId\" IS NULL"), map: "CarteFamille_famille_en_attente")
  @@unique([enfantId], where: raw("\"revoqueeLe\" IS NULL AND \"activeLe\" IS NULL AND \"enfantId\" IS NOT NULL"), map: "CarteFamille_enfant_en_attente")
  @@index([familleId])
  @@index([reemissionId])
}

// Badge moniteur (RG-02, RG-03, RG-14, ADR 0008) : historique des badges d'un membre de
// l'église. Le nouveau badge est actif dès l'impression et révoque le précédent ; au plus un
// badge non révoqué par membre (index partiel). Un membre désactivé ou qui perd le rôle
// MONITEUR voit son badge révoqué.
model BadgeMoniteur {
  id        String    @id @default(cuid())
  egliseId  String
  eglise    Eglise    @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  membreId  String
  membre    Membre    @relation(fields: [membreId, egliseId], references: [id, egliseId], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 hexadécimal du jeton HKB1. ; le jeton en clair n'est jamais stocké
  emisLe    DateTime  @default(now())
  revoqueLe DateTime?

  @@unique([id, egliseId])
  @@unique([membreId], where: raw("\"revoqueLe\" IS NULL"), map: "BadgeMoniteur_un_actif_par_membre")
  @@index([egliseId, membreId])
}

// Réémission groupée (RG-16) : changement de mode, de logo ou de format. Les cartes émises
// restent en attente ; après la date limite, les anciennes cartes non remplacées sont refusées
// au scan et révoquées par la tâche quotidienne.
model ReemissionCartes {
  id         String    @id @default(cuid())
  egliseId   String
  eglise     Eglise    @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  mode       ModeCarte
  dateLimite DateTime?
  creeLe     DateTime  @default(now())
  creePar    String

  cartes CarteFamille[]

  @@unique([id, egliseId])
  @@index([egliseId, creeLe])
}

model Classe {
  id           String  @id @default(cuid())
  egliseId     String
  eglise       Eglise  @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  nom          String
  ageMinMois   Int
  ageMaxMois   Int
  salle        String?
  capacite     Int?
  minMoniteurs Int     @default(2) // RG-05
  ordre        Int     @default(0)
  active       Boolean @default(true)

  enfantsForces  Enfant[]
  sessionClasses SessionClasse[]
  presences      Presence[]

  @@unique([id, egliseId])
  @@index([egliseId, ordre])
}

model Culte {
  id         String  @id @default(cuid())
  egliseId   String
  eglise     Eglise  @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  nom        String
  jour       Int // 0 = dimanche … 6 = samedi
  heureDebut String // "08:00", heure locale de l'église (RG-12)
  heureFin   String
  actif      Boolean @default(true)

  sessions Session[]

  @@unique([id, egliseId])
  @@index([egliseId])
}

model Session {
  id           String        @id @default(cuid())
  egliseId     String
  eglise       Eglise        @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  culteId      String?
  culte        Culte?        @relation(fields: [culteId, egliseId], references: [id, egliseId], onDelete: Restrict)
  date         DateTime      @db.Date
  debut        DateTime // UTC
  fin          DateTime // UTC
  statut       StatutSession @default(PLANIFIEE)
  clotureMotif String?

  classes               SessionClasse[]
  presences             Presence[]
  incidents             Incident[]
  retraitsExceptionnels RetraitExceptionnel[]

  @@unique([egliseId, culteId, date])
  @@unique([id, egliseId])
  @@index([egliseId, date])
}

model SessionClasse {
  id           String    @id @default(cuid())
  egliseId     String
  eglise       Eglise    @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  sessionId    String
  session      Session   @relation(fields: [sessionId, egliseId], references: [id, egliseId], onDelete: Cascade)
  classeId     String
  classe       Classe    @relation(fields: [classeId, egliseId], references: [id, egliseId], onDelete: Restrict)
  ouverteLe    DateTime?
  forcageMotif String? // ouverture forcée par un RESPONSABLE (RG-05)
  forcePar     String?
  forceur      User?     @relation("ForcageClasse", fields: [forcePar], references: [id])

  moniteurs AffectationMoniteur[]

  @@unique([sessionId, classeId])
  @@unique([id, egliseId])
}

model AffectationMoniteur {
  id              String        @id @default(cuid())
  egliseId        String
  eglise          Eglise        @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  sessionClasseId String
  sessionClasse   SessionClasse @relation(fields: [sessionClasseId, egliseId], references: [id, egliseId], onDelete: Cascade)
  membreId        String
  membre          Membre        @relation(fields: [membreId, egliseId], references: [id, egliseId], onDelete: Restrict)
  renfort         Boolean       @default(false) // moniteur temporaire pour la session
  arrivee         DateTime      @default(now())
  depart          DateTime?

  // Un moniteur n'est que dans une classe à la fois : rejoindre une classe termine
  // l'affectation précédente (depart), la clôture d'une session aussi.
  @@unique([membreId], where: raw("\"depart\" IS NULL"), map: "AffectationMoniteur_une_active_par_membre")
  @@index([egliseId, sessionClasseId])
}

model Presence {
  id                    String               @id @default(cuid())
  egliseId              String
  eglise                Eglise               @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  sessionId             String
  session               Session              @relation(fields: [sessionId, egliseId], references: [id, egliseId], onDelete: Restrict)
  enfantId              String
  enfant                Enfant               @relation(fields: [enfantId, egliseId], references: [id, egliseId], onDelete: Restrict)
  classeId              String
  classe                Classe               @relation(fields: [classeId, egliseId], references: [id, egliseId], onDelete: Restrict)
  statut                StatutPresence
  codeRetrait           String // 4 caractères, valable pour cette session seulement (RG-04)
  checkinPar            String
  checkinLe             DateTime             @default(now())
  enSalleLe             DateTime?
  // Infirmerie (lot 3, ADR 0019). infirmerieLe : envoi, non nul si et seulement si le statut est
  // INFIRMERIE (CHECK) ; infirmerieRecueLe : réception par l'infirmerie (« en route » tant que
  // NULL). Accompagnant et motif dans le détail de l'événement « infirmerie ».
  infirmerieLe          DateTime?
  infirmerieRecueLe     DateTime?
  // Dernier renvoi en classe : l'alerte « pas encore en salle » part de cette heure-là.
  retourInfirmerieLe    DateTime?
  recupereLe            DateTime?
  recuperePar           String? // personne autorisée qui a récupéré l'enfant
  autorise              PersonneAutorisee?   @relation(fields: [recuperePar, egliseId], references: [id, egliseId], onDelete: Restrict)
  remisPar              String? // compte qui a remis l'enfant
  // Retrait exceptionnel (cahier §7.6). Contraintes CHECK de la migration lot2_sessions :
  // jamais avec recuperePar, et un statut RECUPERE exige exactement l'un des deux.
  retraitExceptionnelId String?
  retraitExceptionnel   RetraitExceptionnel? @relation(fields: [retraitExceptionnelId, egliseId], references: [id, egliseId], onDelete: Restrict)
  basculeVers           String? // présence créée dans la session suivante
  basculeCible          Presence?            @relation("Bascule", fields: [basculeVers, egliseId], references: [id, egliseId], onDelete: Restrict)
  basculeSource         Presence?            @relation("Bascule")

  evenements          EvenementPresence[]
  appels              Appel[]
  appelsTelephoniques AppelTelephonique[]

  @@unique([id, egliseId])
  @@unique([basculeVers, egliseId])
  // RG-08 : une seule présence non clôturée par enfant.
  @@unique([enfantId], where: raw("statut <> 'RECUPERE' AND \"basculeVers\" IS NULL"), map: "Presence_une_ouverte_par_enfant")
  @@index([egliseId, sessionId, statut])
  @@index([sessionId, codeRetrait])
}

// Historique d'une présence. Non modifiable (droits SELECT et INSERT uniquement).
model EvenementPresence {
  id         String   @id @default(cuid())
  egliseId   String
  eglise     Eglise   @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  presenceId String
  presence   Presence @relation(fields: [presenceId, egliseId], references: [id, egliseId], onDelete: Restrict)
  type       String
  detail     Json?
  userId     String
  appareil   String?
  createdAt  DateTime @default(now())

  @@index([presenceId, createdAt])
}

// Appel d'un parent, affiché sur l'écran d'appel (matricule + lieu, jamais de nom : RG-10).
// Un seul appel ouvert par présence (index partiel). Contraintes CHECK de la migration
// lot3_infirmerie_appels : motif et résolution dans leur liste ; résolu le, résolution et
// résolu par, tous nuls ou tous renseignés. Seules les colonnes de résolution se modifient,
// une seule fois (droits par colonne et déclencheur).
model Appel {
  id         String    @id @default(cuid())
  egliseId   String
  eglise     Eglise    @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  presenceId String
  presence   Presence  @relation(fields: [presenceId, egliseId], references: [id, egliseId], onDelete: Restrict)
  motif      String // pleurs | change | soins | comportement | autre
  lieu       String // un des lieux de rendez-vous (appels.lieux), recopié
  creeLe     DateTime  @default(now())
  creePar    String
  resoluLe   DateTime?
  resolution String? // parent_arrive | annule | recupere (check-out)
  resoluPar  String?

  @@unique([presenceId], where: raw("\"resoluLe\" IS NULL"), map: "Appel_un_ouvert_par_presence")
  @@index([egliseId, resoluLe])
}

// Journal des appels téléphoniques et WhatsApp lancés depuis le bouton Urgence. En ajout seul :
// seul le résultat se renseigne, une fois (droits par colonne et déclencheur). Numéro au format
// E.164 (CHECK, ADR 0011) ; canal et résultat dans leur liste (CHECK).
model AppelTelephonique {
  id         String    @id @default(cuid())
  egliseId   String
  eglise     Eglise    @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  presenceId String?
  presence   Presence? @relation(fields: [presenceId, egliseId], references: [id, egliseId], onDelete: Restrict)
  enfantId   String
  enfant     Enfant    @relation(fields: [enfantId, egliseId], references: [id, egliseId], onDelete: Restrict)
  numero     String
  canal      String // tel | whatsapp
  resultat   String? // joint | pas_de_reponse | messagerie
  resultatLe DateTime? // non nul si et seulement si resultat l'est
  userId     String
  createdAt  DateTime  @default(now())

  @@index([egliseId, enfantId])
  @@index([presenceId, createdAt])
}

model Incident {
  id          String       @id @default(cuid())
  egliseId    String
  eglise      Eglise       @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  sessionId   String?
  session     Session?     @relation(fields: [sessionId, egliseId], references: [id, egliseId], onDelete: Restrict)
  enfantId    String?
  enfant      Enfant?      @relation(fields: [enfantId, egliseId], references: [id, egliseId], onDelete: Restrict)
  type        TypeIncident
  description String
  personnes   String?
  mesures     String?
  declarePar  String
  createdAt   DateTime     @default(now())
  // Une fois déclaré, le contenu ne se modifie plus (droits par colonne) : seule la clôture se
  // pose, une fois (déclencheur). Les compléments passent par IncidentNote.
  clotureLe   DateTime?
  cloturePar  String? // non nul si et seulement si clotureLe l'est (CHECK)

  retraitExceptionnel RetraitExceptionnel?
  notes               IncidentNote[]

  @@unique([id, egliseId])
  @@index([egliseId, sessionId])
}

// Complément apporté à un incident après sa déclaration. En ajout seul (RG-09).
model IncidentNote {
  id         String   @id @default(cuid())
  egliseId   String
  eglise     Eglise   @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  incidentId String
  incident   Incident @relation(fields: [incidentId, egliseId], references: [id, egliseId], onDelete: Restrict)
  texte      String
  auteur     String // userId
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

// Retrait par un adulte absent des personnes autorisées (cahier §7.6), après appel du contact
// principal : autorisé par un RESPONSABLE ou un ADMIN actif de l'église, authentifié par son
// PIN sur la tablette. Créé avec son incident RETRAIT_NON_AUTORISE, dans la même transaction.
model RetraitExceptionnel {
  id          String   @id @default(cuid())
  egliseId    String
  eglise      Eglise   @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  sessionId   String
  session     Session  @relation(fields: [sessionId, egliseId], references: [id, egliseId], onDelete: Restrict)
  familleId   String
  famille     Famille  @relation(fields: [familleId, egliseId], references: [id, egliseId], onDelete: Restrict)
  nom         String // adulte non reconnu, tel qu'il se présente
  lien        String?
  telephone   String? // E.164 (contrainte CHECK)
  photoKey    String // photo prise sur la tablette, sous eglises/{egliseId}/ (RG-15)
  motif       String
  autorisePar String // RESPONSABLE ou ADMIN actif de l'église, authentifié par son PIN
  autoriseur  User     @relation("RetraitAutorisePar", fields: [autorisePar], references: [id], onDelete: Restrict)
  remisPar    String // agent qui remet l'enfant
  remetteur   User     @relation("RetraitRemisPar", fields: [remisPar], references: [id], onDelete: Restrict)
  incidentId  String
  incident    Incident @relation(fields: [incidentId, egliseId], references: [id, egliseId], onDelete: Restrict)
  createdAt   DateTime @default(now())

  presences Presence[]

  @@unique([id, egliseId])
  @@unique([incidentId, egliseId]) // un retrait par incident
  @@index([egliseId, sessionId])
}

// Journal d'audit d'une église (RG-09). Non modifiable (droits SELECT et INSERT uniquement).
model AuditLog {
  id        String   @id @default(cuid())
  egliseId  String
  eglise    Eglise   @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  userId    String?
  action    String
  entite    String
  entiteId  String
  avant     Json?
  apres     Json?
  appareil  String?
  createdAt DateTime @default(now())

  @@index([egliseId, entite, entiteId])
  @@index([egliseId, createdAt])
}

// Paramètres d'une église : délais d'alerte, lieux de rendez-vous, textes de la carte
// famille et du consentement, durée de conservation…
model Parametre {
  egliseId String
  eglise   Eglise @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  cle      String
  valeur   Json

  @@id([egliseId, cle])
}

// Fichier remplacé (ancien logo, ancienne photo), supprimé par la tâche quotidienne à partir de
// `apresLe` (24 h après le remplacement) : une tablette qui affiche encore l'ancienne page ne
// montre jamais une image cassée. La clé est vérifiée (préfixe de l'église) avant suppression.
model FichierASupprimer {
  id       String   @id @default(cuid())
  egliseId String
  eglise   Eglise   @relation(fields: [egliseId], references: [id], onDelete: Restrict)
  cle      String // eglises/{egliseId}/...
  apresLe  DateTime
  creeLe   DateTime @default(now())

  @@unique([id, egliseId])
  @@unique([egliseId, cle])
  @@index([apresLe])
}
